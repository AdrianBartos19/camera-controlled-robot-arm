<robot name="robot_arm">
    <!-- 1️⃣ Base -->
    <link name="base_link">
        <visual>
            <origin xyz="-0.06 0 0.025" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.05" radius="0.0625"/>
            </geometry>
        </visual>    
    </link>

    <!-- 2️⃣ Base Rotation Joint -->
    <joint name="base_joint" type="revolute">
        <origin xyz="-0.06 0 0.05" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="rameno_link"/>
        <axis xyz="0.0 0.0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    </joint>

    <!-- 3️⃣ First Arm Segment (Rameno) -->
    <link name="rameno_link">
        <visual>
            <origin xyz="0 0 0.0165" rpy="0 0 0"/>
            <geometry>
                <box size="0.04 0.04 0.033"/>
            </geometry>
        </visual>    
    </link>

    <!-- 4️⃣ Shoulder Joint -->
    <joint name="rameno_joint" type="revolute">
        <origin xyz="-0.025 0 0.033" rpy="0 0 0"/>  <!-- Placed at 8.3 cm -->
        <parent link="rameno_link"/>
        <child link="elbow_link"/>
        <axis xyz="0.0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    </joint>

    <!-- 5️⃣ Elbow Link (Length: 10.7 cm) -->
    <link name="elbow_link">
        <visual>
            <origin xyz="0 0 0.0535" rpy="0 0 0"/> <!-- Centered at half of its length -->
            <geometry>
                <cylinder length="0.107" radius="0.02"/>
            </geometry>
        </visual>    
    </link>

    <!-- 6️⃣ Elbow Joint (at top of elbow_link) -->
    <joint name="elbow_joint" type="revolute">
        <origin xyz="0 0 0.107" rpy="0 0 0"/>  <!-- Corrected: Placed at 19.0 cm -->
        <parent link="elbow_link"/>
        <child link="forearm_link"/>
        <axis xyz="0.0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    </joint>

    <!-- 7️⃣ Forearm Link (New Segment) -->
    <link name="forearm_link">
        <visual>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.099" radius="0.018"/>
            </geometry>
        </visual>    
    </link>
    <joint name="wrist_joint" type="revolute">
        <origin xyz="0 0 0.099" rpy="0 0 0"/>  <!-- Corrected: Placed at 19.0 cm -->
        <parent link="forearm_link"/>
        <child link="wrist_link"/>
        <axis xyz="0.0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    </joint>
    
    <link name="wrist_link">
        <visual>
            <origin xyz="0 0 0.049" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.098" radius="0.018"/>
            </geometry>
        </visual>    
    </link>

    <joint name="rot_joint" type="revolute">
        <origin xyz="0 -0.03 0.098" rpy="0 0 0"/>  
        <parent link="wrist_link"/>
        <child link="gripper_link"/>
        <axis xyz="0.0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    </joint>

    <link name="gripper_link">
        <visual>
            <origin xyz="0 0 0.03" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.05 0.06"/>
            </geometry>
        </visual>    
    </link>

    <joint name="gripper_joint" type="revolute">
        <origin xyz="0 0 0.03" rpy="0 0 0"/>  
        <parent link="gripper_link"/>
        <child link="claw_link"/>
        <axis xyz="0.0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    </joint>

    <link name="claw_link">
        <visual>
            <origin xyz="0 0 0.03" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.05 0.06"/>
            </geometry>
        </visual>    
    </link>


   

</robot>
